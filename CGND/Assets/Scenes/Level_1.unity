    m_Flags: 0
  levelStartPoint: {fileID: 1671064758}
  playerPrefab: {fileID: 7089567270684831309, guid: cee59568fac267146921019335b0f5ca, type: 3}
  waitToRespawn: 0
  openingTimeline: {fileID: 1149387714}
  dummyCharacter: {fileID: 189682815291674067}
  openingDialogue:
    dialogueLines:
    - side: 1
      line: "ZZZ\u2026"
    - side: 0
      line: "(stops walking)\nWas that\u2026 a sound?"
    - side: 1
      line: "\u2026Mmm\u2026 five more minutes\u2026"
    - side: 0
      line: "The rock\u2026 just talked?!"
    - side: 1
      line: "Hmph. Ignorant human.\nI am one of the Ancient Crystalline Consciousnesses\u2026\n\u2026but
        you may simply call me \u201CRock.\u201D"
    - side: 0
      line: "(speechless) \u2026"
    - side: 1
      line: "More importantly\u2014\nwhat is a human doing wandering around a place
        like this?\nThis is hardly a safe route for a casual stroll."
    - side: 0
      line: "I\u2019m searching for a medicinal herb.\nMy father was cursed\u2026
        and I have to save him."
    - side: 1
      line: "\u2026A curse, huh. \nThen you\u2019ll be traveling deep into dangerous
        territory."
    - side: 1
      line: "In that case\u2026\nhow about we make a deal?"
    - side: 0
      line: A deal?
    - side: 1
      line: "Throughout this world, there are scattered Crystal Shards. \nFragments
        of power born from the same source as me."
    - side: 1
      line: "If you happen to find any on your journey\u2014 bring them back to me."
    - side: 0
      line: "\u2026That sounds suspicious."
    - side: 0
      line: "Then I\u2019ll give you two Crystal Shards right now.\nUse them, and
        you\u2019ll see the difference yourself."
  healthUIAnimator: {fileID: 1235281527}
  crystalParent: {fileID: 79535199534235239}
  crystals:
  - {fileID: 7822563008045266460}
  - {fileID: 3031441370046369886}
  crystalFlySpeed: 5
  SkillTreeManager: {fileID: 6828871416286035147}
  SkillTreeTutorialPanel: {fileID: 6799381640215160805}
